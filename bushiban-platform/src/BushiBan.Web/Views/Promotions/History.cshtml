@model PagedList<BushiBan.Web.Features.Academics.PromotionHistoryRow>
@{
    ViewData["Title"] = "Promotion history";
    ViewData["Breadcrumbs"] = new List<(string, string?)> { ("Belt promotions", Url.Action("Index")), ("History", null) };
    var courses = ViewData["Courses"] as List<SelectListItem> ?? new();
}
@section Actions {
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-award me-1"></i>Ready to test</a>
}
<div class="card">
    <div class="card-header bg-transparent">
        <form method="get" data-autosubmit class="row g-2">
            <div class="col-md-5 col-lg-4">
                <select class="form-select" name="courseId" aria-label="Program">
                    <option value="">All programs</option>
                    @foreach (var c in courses) { <option value="@c.Value" selected="@c.Selected">@c.Text</option> }
                </select>
            </div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Date</th><th>Student</th><th>Promotion</th><th>Notes</th><th>Recorded by</th></tr></thead>
            <tbody>
            @if (Model.Items.Count == 0) { <tr><td colspan="5" class="empty">No promotions recorded yet.</td></tr> }
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td class="text-nowrap">@Format.Date(p.PromotedOn)</td>
                    <td><a class="fw-medium" asp-controller="Students" asp-action="Details" asp-route-id="@p.StudentId">@p.Student</a> <span class="small text-body-secondary">@p.StudentNo</span></td>
                    <td class="text-nowrap">
                        @if (p.FromRank is not null) { <span class="belt" style="--belt:@(p.FromColor ?? "#ccc")">@p.FromRank</span><i class="bi bi-arrow-right mx-1 text-body-secondary"></i> }
                        <span class="belt" style="--belt:@(p.ToColor ?? "#ccc")">@p.ToRank</span>
                    </td>
                    <td>@p.Notes</td>
                    <td class="small">@p.RecordedBy</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="(Model.Page, Model.Pages, Model.Total)" />
