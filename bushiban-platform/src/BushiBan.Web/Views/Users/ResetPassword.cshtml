@model BushiBan.Web.Features.Administration.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    ViewData["Breadcrumbs"] = new List<(string, string?)> { ("Users", Url.Action("Index")), (Model.Name, Url.Action("Edit", new { id = Model.Id })), ("Reset password", null) };
}
<form method="post" class="card form-card" style="max-width: 560px" novalidate>
    <div class="card-body">
        @if (ViewContext.ViewData.ModelState.TryGetValue("", out var top) && top.Errors.Count > 0)
        {
            <div class="alert alert-danger"><ul class="mb-0 ps-3">@foreach (var e in top.Errors) { <li>@e.ErrorMessage</li> }</ul></div>
        }
        <p>Set a new password for <strong>@Model.Name</strong> (@Model.Email). They'll be signed out everywhere and the account is unlocked if it was locked.</p>
        <div class="mb-3">
            <label class="form-label" for="NewPassword">New password</label>
            <div class="input-group">
                <input class="form-control" id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" />
                <button type="button" class="btn btn-outline-secondary" id="genPassword" title="Make up a strong password"><i class="bi bi-magic"></i></button>
            </div>
            <div class="form-text">At least 8 characters with upper and lower case letters and a number.</div>
        </div>
        <div class="mb-1">
            <label class="form-label" for="ConfirmPassword">Confirm new password</label>
            <input class="form-control" id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" />
        </div>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        <button class="btn btn-primary"><i class="bi bi-key me-1"></i>Set new password</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
@section Scripts {
<script>
document.getElementById('genPassword').addEventListener('click', () => {
  const sets = ['ABCDEFGHJKLMNPQRSTUVWXYZ', 'abcdefghijkmnopqrstuvwxyz', '23456789', '!#%+='];
  const rand = n => crypto.getRandomValues(new Uint32Array(1))[0] % n;
  let pw = sets.map(s => s[rand(s.length)]).join('');
  const all = sets.join('');
  while (pw.length < 14) pw += all[rand(all.length)];
  for (const id of ['NewPassword', 'ConfirmPassword']) { const f = document.getElementById(id); f.value = pw; f.type = 'text'; }
});
</script>
}
