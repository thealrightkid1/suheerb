@{ ViewData["Title"] = "Access denied"; Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout"; }
<div class="card"><div class="card-body">
    <p class="mb-2"><i class="bi bi-shield-lock text-danger me-2"></i>You don't have permission to open that page.</p>
    <p class="text-body-secondary mb-3">If you need access, ask a manager to update your permissions under Administration → Users.</p>
    <a class="btn btn-primary" href="~/">Back to the dashboard</a>
</div></div>
