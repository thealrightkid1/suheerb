@* Top-of-form messages for the lead/student editors: validation summary and the possible-duplicate warning. *@
@model PersonForm
@{
    var errors = ViewContext.ViewData.ModelState.Where(kv => kv.Value!.Errors.Count > 0).ToList();
}
@if (errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>Please fix the @(errors.Count == 1 ? "highlighted field" : $"{errors.Count} highlighted fields") below.
        @foreach (var e in errors.Where(kv => kv.Key == ""))
        {
            <div>@e.Value!.Errors[0].ErrorMessage</div>
        }
    </div>
}
@if (Model.Options.Duplicates.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <div class="fw-semibold mb-1"><i class="bi bi-people me-2"></i>This might be someone you already have</div>
        <p class="mb-2 small">The phone number or email matches @(Model.Options.Duplicates.Count == 1 ? "this record" : "these records"). Open one to check, or save anyway if it's a different person (for example a sibling).</p>
        <ul class="mb-3 small">
            @foreach (var d in Model.Options.Duplicates)
            {
                <li>
                    <span class="badge @(d.Kind == "Student" ? "text-bg-success" : "text-bg-secondary")">@d.Kind</span>
                    <a href="@Url.Action("Details", d.Kind == "Student" ? "Students" : "Leads", new { id = d.Id })" target="_blank" rel="noopener">@d.Name</a>
                    <span class="text-body-secondary">· @d.Phone @(d.Email is null ? "" : "· " + d.Email) · @d.Detail</span>
                </li>
            }
        </ul>
        <button class="btn btn-warning btn-sm" name="IgnoreDuplicates" value="true"><i class="bi bi-check-lg me-1"></i>Save anyway</button>
    </div>
}
