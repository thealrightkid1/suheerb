@model BushiBan.Web.Features.Academics.CourseDetails
@using BushiBan.Web.Features.Academics
@{
    ViewData["Title"] = Model.Name;
    ViewData["Breadcrumbs"] = new List<(string, string?)> { ("Programs", Url.Action("Index")), (Model.Name, null) };
    var byDay = Model.Schedule.GroupBy(s => s.Day).ToDictionary(g => g.Key, g => g.ToList());
}
@section Head { <link rel="stylesheet" href="~/css/academics.css" asp-append-version="true" /> }
@section Actions {
    @if (User.HasPermission(Permissions.Attendance.Create))
    {
        <a class="btn btn-outline-secondary" asp-controller="Attendance" asp-action="Roll" asp-route-courseId="@Model.Id"><i class="bi bi-check2-square me-1"></i>Take attendance</a>
    }
    @if (User.HasPermission(Permissions.Courses.Edit))
    {
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil me-1"></i>Edit</a>
    }
    @if (User.HasPermission(Permissions.Courses.Delete))
    {
        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" data-confirm="Delete the program @Model.Name? You can ask an admin to restore it later.">
            <button class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
        </form>
    }
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="card-title-sm mb-0">About</div>
                <span class="badge @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span>
            </div>
            <p>@(Model.Description ?? "No description.")</p>
            <dl class="row small mb-0">
                <dt class="col-7 fw-normal text-body-secondary">Minimum term</dt><dd class="col-5 text-end">@Model.MinimumTermMonths months</dd>
                <dt class="col-7 fw-normal text-body-secondary">Active students</dt><dd class="col-5 text-end">@Model.Students.Count</dd>
                <dt class="col-7 fw-normal text-body-secondary">Open leads interested</dt><dd class="col-5 text-end">@Model.Leads</dd>
            </dl>
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <div class="card-title-sm">Fees</div>
            @if (Model.FeeStructure is null)
            {
                <p class="text-body-secondary mb-0">No fee structure set.</p>
            }
            else
            {
                <div class="fw-medium mb-2">@Model.FeeStructure</div>
                <dl class="row small mb-0">
                    <dt class="col-7 fw-normal text-body-secondary">Admission fee</dt><dd class="col-5 text-end">@Format.Money(Model.AdmissionFee)</dd>
                    <dt class="col-7 fw-normal text-body-secondary">Security deposit</dt><dd class="col-5 text-end">@Format.Money(Model.SecurityFee)</dd>
                    <dt class="col-7 fw-normal text-body-secondary">Monthly fee</dt><dd class="col-5 text-end fw-semibold">@Format.Money(Model.MonthlyFee)</dd>
                </dl>
            }
        </div></div>

        <div class="card"><div class="card-body">
            <div class="card-title-sm">Belt progression</div>
            @if (Model.RankingSystems.Count == 0)
            {
                <p class="text-body-secondary mb-0">No ranking system. Add one so students can be promoted.</p>
            }
            else
            {
                <div class="small text-body-secondary mb-2">
                    @for (var i = 0; i < Model.RankingSystems.Count; i++)
                    {
                        <a asp-controller="RankingSystems" asp-action="Details" asp-route-id="@Model.RankingSystems[i].Id">@Model.RankingSystems[i].Name</a>@(i < Model.RankingSystems.Count - 1 ? ", then " : "")
                    }
                </div>
                <ol class="belt-path">
                    @foreach (var s in Model.Path)
                    {
                        <li><span class="belt" style="--belt:@(s.Color ?? "#ccc")">@s.Rank</span><span class="small text-body-secondary">@s.DurationInDays days@(s.MinimumClasses > 0 ? $" · {s.MinimumClasses} classes" : "")</span></li>
                    }
                </ol>
            }
        </div></div>
    </div>

    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header bg-transparent fw-semibold">Weekly schedule</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <tbody>
                    @foreach (var day in CourseForm.Week)
                    {
                        <tr>
                            <th class="text-body-secondary fw-medium" style="width:9rem">@day</th>
                            <td>
                                @if (!byDay.TryGetValue(day, out var classes)) { <span class="text-body-secondary">—</span> }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var c in classes)
                                        {
                                            <span class="schedule-pill @(c.IsActive ? "" : "inactive")"><i class="bi bi-clock me-1"></i>@c.Times@if (c.Instructor is not null) { <span class="text-body-secondary"> · @c.Instructor</span> }</span>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-transparent fw-semibold">Students enrolled <span class="badge text-bg-light border">@Model.Students.Count</span></div>
            <div class="table-responsive" style="max-height:520px">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Student</th><th>Belt</th><th>Enrolled</th></tr></thead>
                    <tbody>
                    @if (Model.Students.Count == 0) { <tr><td colspan="3" class="empty">No active students in this program yet.</td></tr> }
                    @foreach (var s in Model.Students)
                    {
                        <tr>
                            <td><a class="fw-medium" asp-controller="Students" asp-action="Details" asp-route-id="@s.Id">@s.Name</a> <span class="small text-body-secondary">@s.StudentNo</span></td>
                            <td>@if (s.Belt is not null) { <span class="belt" style="--belt:@(s.BeltColor ?? "#ccc")">@s.Belt</span> }</td>
                            <td>@Format.Date(s.EnrolledOn)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
