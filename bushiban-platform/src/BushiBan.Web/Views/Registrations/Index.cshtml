@model RegistrationIndexModel
@{
    ViewData["Title"] = "Registrations";
    ViewData["Breadcrumbs"] = new List<(string, string?)> { ("Registrations", null) };
    var f = Model.Filter;
    var canManage = User.HasPermission(Permissions.Registrations.Manage);
    var statuses = new List<(string Value, string Label)> { ("inbox", "Inbox (not archived)"), ("all", "Everything") };
    statuses.AddRange(Enum.GetValues<SubmissionStatus>().Select(s => (s.ToString(), s.DisplayName())));
}
@section Head { <link rel="stylesheet" href="~/css/crm.css" asp-append-version="true" /> }
<p class="text-body-secondary">Forms filled in on the registration kiosk. Open one to read the answers and signatures, then turn it into a lead or student, or link it to someone you already have.</p>
<div class="card">
    <div class="card-header bg-transparent">
        <form method="get" class="row g-2 align-items-end" data-autosubmit>
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label small mb-1" for="q">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input class="form-control" id="q" name="q" value="@f.Q" placeholder="Name, phone or email" />
                </div>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small mb-1" for="status">Status</label>
                <select class="form-select" id="status" name="status">
                    @foreach (var (value, label) in statuses) { <option value="@value" selected="@(string.Equals(f.Status, value, StringComparison.OrdinalIgnoreCase))">@label</option> }
                </select>
            </div>
            <div class="col-6 col-md-3 col-xl-3">
                <label class="form-label small mb-1" for="formId">Form</label>
                <select class="form-select" id="formId" name="formId" asp-items="Model.Forms"><option value="">Any form</option></select>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small mb-1" for="from">Submitted from</label>
                <input class="form-control" type="date" id="from" name="from" value="@f.From?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small mb-1" for="to">Submitted to</label>
                <input class="form-control" type="date" id="to" name="to" value="@f.To?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary"><i class="bi bi-funnel me-1"></i>Filter</button>
                @if (f.IsFiltered) { <a class="btn btn-link" asp-action="Index">Clear</a> }
            </div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr>
                <th>Student</th><th class="d-none d-md-table-cell">Contact</th><th>Form</th><th>Submitted</th><th>Status</th><th>Linked to</th>
                <th class="d-none d-lg-table-cell">Phone</th><th class="d-none d-xl-table-cell">Email</th><th class="text-end">Actions</th>
            </tr></thead>
            <tbody>
            @if (Model.Rows.Items.Count == 0)
            {
                <tr><td colspan="9" class="empty">@(f.IsFiltered ? "No registrations match these filters." : "The inbox is empty. New kiosk registrations will appear here.")</td></tr>
            }
            @foreach (var r in Model.Rows.Items)
            {
                <tr class="@(r.Status == SubmissionStatus.New ? "fw-semibold" : "")">
                    <td><a asp-action="Details" asp-route-id="@r.Id">@(string.IsNullOrEmpty(r.Name) ? "(no name)" : r.Name)</a></td>
                    <td class="d-none d-md-table-cell">@r.Contact</td>
                    <td class="small">@r.Form</td>
                    <td class="text-nowrap small">@Format.DateTime(Model.ToLocal(r.SubmittedAt))</td>
                    <td><span class="badge @CrmUi.StatusClass(r.Status)">@r.Status.DisplayName()</span></td>
                    <td class="small">
                        @if (r.StudentId is int sid) { <a asp-controller="Students" asp-action="Details" asp-route-id="@sid"><i class="bi bi-person-check me-1"></i>@r.StudentName</a> }
                        else if (r.LeadId is int lid) { <a asp-controller="Leads" asp-action="Details" asp-route-id="@lid"><i class="bi bi-person-plus me-1"></i>@r.LeadName</a> }
                        else { <span class="text-body-secondary">Not linked</span> }
                    </td>
                    <td class="d-none d-lg-table-cell text-nowrap">@r.Phone</td>
                    <td class="d-none d-xl-table-cell">@r.Email</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@r.Id" title="Open"><i class="bi bi-eye"></i></a>
                        @if (canManage)
                        {
                            <form method="post" asp-action="Archive" asp-route-id="@r.Id" class="d-inline">
                                <button class="btn btn-sm btn-outline-secondary" title="@(r.Status == SubmissionStatus.Archived ? "Move back to inbox" : "Archive")"><i class="bi bi-@(r.Status == SubmissionStatus.Archived ? "inbox" : "archive")"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="(Model.Rows.Page, Model.Rows.Pages, Model.Rows.Total)" />
