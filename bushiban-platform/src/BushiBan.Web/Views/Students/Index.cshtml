@model StudentIndexModel
@{
    ViewData["Title"] = "Students";
    ViewData["Breadcrumbs"] = new List<(string, string?)> { ("Students", null) };
    var f = Model.Filter;
    var canEdit = User.HasPermission(Permissions.Students.Edit);
    var canDelete = User.HasPermission(Permissions.Students.Delete);
}
@section Head { <link rel="stylesheet" href="~/css/crm.css" asp-append-version="true" /> }
@section Actions {
    @if (User.HasPermission(Permissions.Students.Create))
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add student</a>
    }
}
<div class="card">
    <div class="card-header bg-transparent">
        <form method="get" class="row g-2 align-items-end" data-autosubmit>
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label small mb-1" for="q">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input class="form-control" id="q" name="q" value="@f.Q" placeholder="Name, student no., phone or email" />
                </div>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small mb-1" for="courseId">Program</label>
                <select class="form-select" id="courseId" name="courseId" asp-items="Model.Courses"><option value="">Any program</option></select>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small mb-1" for="rankId">Rank</label>
                <select class="form-select" id="rankId" name="rankId" asp-items="Model.Ranks"><option value="">Any rank</option></select>
            </div>
            <div class="col-6 col-md-3 col-xl-1">
                <label class="form-label small mb-1" for="ageGroup">Age group</label>
                <select class="form-select" id="ageGroup" name="ageGroup" asp-items="EnumHelpers.SelectList(f.AgeGroup)"><option value="">Any</option></select>
            </div>
            <div class="col-6 col-md-3 col-xl-1">
                <label class="form-label small mb-1" for="active">Status</label>
                <select class="form-select" id="active" name="active">
                    <option value="yes" selected="@(f.Active == "yes")">Active</option>
                    <option value="no" selected="@(f.Active == "no")">Inactive</option>
                    <option value="all" selected="@(f.Active == "all")">All</option>
                </select>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small mb-1" for="sort">Sort by</label>
                <select class="form-select" id="sort" name="sort">
                    <option value="" selected="@(string.IsNullOrEmpty(f.Sort))">Last name</option>
                    <option value="number" selected="@(f.Sort == "number")">Student number</option>
                    <option value="newest" selected="@(f.Sort == "newest")">Newest enrollment</option>
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary"><i class="bi bi-funnel me-1"></i>Filter</button>
                @if (f.IsFiltered || !string.IsNullOrEmpty(f.Sort)) { <a class="btn btn-link" asp-action="Index">Clear</a> }
            </div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr>
                <th>Student no.</th><th>Full name</th><th>Contact</th><th class="d-none d-xxl-table-cell">Email</th><th class="d-none d-xxl-table-cell">City</th>
                <th>Age</th><th>Rank</th><th class="d-none d-md-table-cell">Program</th><th class="d-none d-md-table-cell">Enrolled</th><th>Active</th><th class="text-end">Actions</th>
            </tr></thead>
            <tbody>
            @if (Model.Rows.Items.Count == 0)
            {
                <tr><td colspan="11" class="empty">@(f.IsFiltered ? "No students match these filters." : "No students yet.")</td></tr>
            }
            @foreach (var r in Model.Rows.Items)
            {
                <tr class="@(r.IsActive ? "" : "row-muted")">
                    <td class="text-nowrap font-monospace small">@r.StudentNo</td>
                    <td><a asp-action="Details" asp-route-id="@r.Id" class="fw-medium text-nowrap">@r.Name</a></td>
                    <td><div class="text-nowrap">@if (r.Phone is not null) { <a href="@CrmUi.TelHref(r.Phone)">@r.Phone</a> }</div>@if (r.Email is not null) { <div class="small d-xxl-none text-truncate cell-email"><a href="mailto:@r.Email" class="text-body-secondary">@r.Email</a></div> }</td>
                    <td class="d-none d-xxl-table-cell">@if (r.Email is not null) { <a href="mailto:@r.Email">@r.Email</a> }</td>
                    <td class="d-none d-xxl-table-cell">@r.City</td>
                    <td>@PeopleService.Age(r.DateOfBirth, Model.Today)</td>
                    <td>@if (r.Rank is not null) { <span class="belt" style="@CrmUi.BeltStyle(r.RankColor)">@r.Rank</span> }</td>
                    <td class="d-none d-md-table-cell small cell-program">@r.Program</td>
                    <td class="d-none d-md-table-cell text-nowrap">@Format.Date(r.EnrollmentDate)</td>
                    <td>@if (r.IsActive) { <span class="badge text-bg-success">Yes</span> } else { <span class="badge text-bg-secondary">No</span> }</td>
                    <td class="text-end text-nowrap">
                        @if (canEdit) { <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@r.Id" title="Edit"><i class="bi bi-pencil"></i></a> }
                        @if (canDelete) { <partial name="_DeleteButton" model='("Students", r.Id, "the student " + r.Name)' /> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="(Model.Rows.Page, Model.Rows.Pages, Model.Rows.Total)" />
