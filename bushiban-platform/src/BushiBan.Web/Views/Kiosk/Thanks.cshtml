@{
    Layout = "_KioskLayout";
    ViewData["Title"] = "Thank you";
    ViewData["KioskHome"] = Url.Action("Register");
    var first = ViewData["FirstName"] as string;
}
<div class="kiosk-card kiosk-done" data-auto-return="@Url.Action("Register")" data-seconds="10">
    <div class="kiosk-done-icon"><i class="bi bi-check-circle-fill"></i></div>
    <h1>Thank you@(string.IsNullOrWhiteSpace(first) ? "" : ", " + first)!</h1>
    <p>Your form has been sent to our front desk. Please let them know you're finished.</p>
    <a class="btn btn-primary btn-lg" asp-action="Register">Done</a>
    <div class="kiosk-countdown"><span></span></div>
</div>
