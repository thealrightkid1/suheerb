@using BushiBan.Web.Features.Accounting
@using BushiBan.Web.Features.Billing
@model PaymentDetailsPage
@{
    ViewData["Title"] = $"Receipt {Model.ReceiptNo}";
    ViewData["Breadcrumbs"] = new List<(string, string?)> { ("Payments", Url.Action("Index")), (Model.ReceiptNo, null) };
    var canVoid = !Model.IsVoided && User.HasPermission(Permissions.Billing.Manage);
}
@section Head { <link rel="stylesheet" href="@Url.Content(FinanceUi.Stylesheet)" asp-append-version="true" /> }
@section Scripts { <script src="@Url.Content(FinanceUi.Script)" asp-append-version="true"></script> }
@section Actions {
    @if (User.HasPermission(Permissions.Billing.ReceivePayments))
    {
        <a class="btn btn-outline-primary" asp-action="Create" asp-route-studentId="@Model.Student.Id"><i class="bi bi-cash me-1"></i>Another payment</a>
    }
    @if (canVoid)
    {
        <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#voidModal"><i class="bi bi-x-circle me-1"></i>Void</button>
    }
    <button class="btn btn-outline-secondary" data-print><i class="bi bi-printer me-1"></i>Print receipt</button>
}

@if (Model.IsVoided)
{
    <div class="alert alert-secondary no-print"><i class="bi bi-x-circle me-2"></i>This payment is void. It no longer pays any invoice. @Model.VoidReason</div>
}

<div class="card doc" style="max-width: 720px">
    <div class="card-body p-4">
        <div class="doc-head">
            <div class="doc-brand">
                <img src="~/img/logo.svg" alt="" width="48" height="48" />
                <div class="doc-party">
                    <div class="school">@Model.Branch.School</div>
                    <div>@Model.Branch.Branch</div>
                    @if (Model.Branch.Address is not null) { <div>@Model.Branch.Address</div> }
                    @if (Model.Branch.CityLine is not null) { <div>@Model.Branch.CityLine</div> }
                    @if (Model.Branch.Phone is not null) { <div class="muted">@Model.Branch.Phone</div> }
                </div>
            </div>
            <div>
                <div class="doc-title">Receipt</div>
                <dl class="doc-meta mt-2 mb-0">
                    <div><dt>Receipt no.</dt><dd>@Model.ReceiptNo</dd></div>
                    <div><dt>Date</dt><dd>@Format.Date(Model.Date)</dd></div>
                </dl>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-sm-6 doc-party">
                <div class="label">Received from</div>
                <div class="fw-semibold">@Model.Student.Name</div>
                <div class="muted small">Student no. @Model.Student.StudentNo</div>
            </div>
            <div class="col-sm-6 doc-party text-sm-end mt-3 mt-sm-0">
                <div class="label">Amount</div>
                <div class="fs-3 fw-bold">@Format.Money(Model.Amount)</div>
                <div>@Model.Method.DisplayName()@if (!string.IsNullOrWhiteSpace(Model.Reference)) { <text> · @Model.Reference</text> }</div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table mb-0">
                <thead><tr><th>Applied to</th><th class="money">Amount</th></tr></thead>
                <tbody>
                @if (Model.Lines.Count == 0 && !Model.IsVoided) { <tr><td colspan="2" class="muted">Not applied to an invoice yet.</td></tr> }
                @foreach (var l in Model.Lines)
                {
                    <tr><td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@l.InvoiceId">@l.InvoiceNo</a> · @l.Description</td><td class="money">@Format.Money(l.Amount)</td></tr>
                }
                @if (Model.Unapplied > 0)
                {
                    <tr><td>Credit on account (used on the next invoice)</td><td class="money">@Format.Money(Model.Unapplied)</td></tr>
                }
                </tbody>
                <tfoot><tr class="doc-total"><td class="text-end">Total received</td><td class="money">@Format.Money(Model.Amount)</td></tr></tfoot>
            </table>
        </div>
        @if (Model.IsVoided) { <div class="mt-3"><span class="doc-stamp void">Void</span></div> }
        @if (Model.StudentBalanceAfter is decimal bal && !Model.IsVoided)
        {
            <p class="mt-3 mb-0">@(bal > 0 ? $"Balance still due on the account: {Format.Money(bal)}." : bal < 0 ? $"Credit on the account: {Format.Money(-bal)}." : "The account is paid in full. Thank you!")</p>
        }
        <div class="doc-foot">
            Received by @(Model.CreatedBy ?? "staff").
            <span class="no-print">Deposited to @Model.DepositAccount.
                @if (Model.VoucherId is not null && User.HasPermission(Permissions.Vouchers.View))
                {
                    <text>Voucher </text><a asp-controller="Vouchers" asp-action="Details" asp-route-id="@Model.VoucherId">@Model.VoucherNo</a><text>.</text>
                }
            </span>
        </div>
    </div>
</div>

@if (canVoid)
{
    <div class="modal fade" id="voidModal" tabindex="-1" aria-labelledby="voidTitle" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-action="Void" asp-route-id="@Model.Id" class="modal-content">
                <div class="modal-header"><h2 class="modal-title fs-5" id="voidTitle">Void @Model.ReceiptNo</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <p class="text-body-secondary">Use this when the money wasn't actually received (bounced check, declined card) or was refunded. The invoices it paid become due again and its voucher is reversed.</p>
                    <label class="form-label" for="voidReason">Reason <span class="text-danger">*</span></label>
                    <input class="form-control" id="voidReason" name="reason" maxlength="200" required placeholder="e.g. Check returned by the bank" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep payment</button>
                    <button class="btn btn-danger">Void payment</button>
                </div>
            </form>
        </div>
    </div>
}
