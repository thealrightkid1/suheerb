@model BushiBan.Web.Features.Academics.RankingSystemDetails
@{
    ViewData["Title"] = Model.Name;
    ViewData["Breadcrumbs"] = new List<(string, string?)> { ("Ranking systems", Url.Action("Index")), (Model.Name, null) };
}
@section Head { <link rel="stylesheet" href="~/css/academics.css" asp-append-version="true" /> }
@section Actions {
    @if (User.HasPermission(Permissions.RankingSystems.Edit))
    {
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil me-1"></i>Edit</a>
    }
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-transparent d-flex justify-content-between">
                <span class="fw-semibold">Progression</span>
                <span class="small text-body-secondary">@Model.Steps.Count belts · about @(Model.TotalDays / 30) months start to finish at the minimum pace</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th style="width:4rem">#</th><th>Belt</th><th class="text-end">Days at belt</th><th class="text-end">Minimum classes</th></tr></thead>
                    <tbody>
                    @if (Model.Steps.Count == 0) { <tr><td colspan="4" class="empty">No belts in this system yet.</td></tr> }
                    @foreach (var s in Model.Steps)
                    {
                        <tr>
                            <td class="text-body-secondary">@s.Index</td>
                            <td><span class="belt belt-lg" style="--belt:@(s.Color ?? "#ccc")">@s.Rank</span></td>
                            <td class="text-end">@s.DurationInDays</td>
                            <td class="text-end">@(s.MinimumClasses == 0 ? "—" : s.MinimumClasses.ToString())</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <div class="card-title-sm">About</div>
            <p class="mb-2">@(Model.Description ?? "No description.")</p>
            <span class="badge @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span>
        </div></div>
        <div class="card"><div class="card-body">
            <div class="card-title-sm">Used by programs</div>
            @if (Model.Programs.Count == 0) { <p class="text-body-secondary mb-0">Not used by any program yet.</p> }
            <ul class="list-unstyled mb-0">
                @foreach (var p in Model.Programs) { <li class="py-1"><a asp-controller="Courses" asp-action="Details" asp-route-id="@p.Id">@p.Name</a></li> }
            </ul>
        </div></div>
    </div>
</div>
