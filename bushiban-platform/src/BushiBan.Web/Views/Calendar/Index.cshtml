@using BushiBan.Web.Features.Communications
@{
    ViewData["Title"] = "Calendar";
    var canManage = ViewData["CanManage"] is true;
    var config = new
    {
        canManage,
        now = ViewData["BranchNow"],
        urls = new { events = Url.Action("Events"), save = Url.Action("Save"), move = Url.Action("Move"), delete = Url.Action("Delete") },
        categories = Enum.GetValues<EventCategory>().Select(c => new { value = (int)c, name = c.ToString(), label = c.DisplayName(), color = CalendarFeed.Colors[c], choosable = CalendarFeed.Choosable.Contains(c) }),
        birthdayColor = CalendarFeed.BirthdayColor,
    };
}
@section Head { <link rel="stylesheet" href="~/css/comms.css" asp-append-version="true" /> }
@section Actions {
    @if (canManage) { <button type="button" class="btn btn-primary" id="addEvent"><i class="bi bi-plus-lg me-1"></i>Add event</button> }
}

<div class="card cal-card">
    <div class="card-header bg-transparent d-flex flex-wrap gap-3 align-items-center">
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="showClasses" checked />
            <label class="form-check-label" for="showClasses">Class schedule</label>
        </div>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="showBirthdays" />
            <label class="form-check-label" for="showBirthdays">Student birthdays</label>
        </div>
        <div class="cal-legend ms-lg-auto">
            @foreach (var c in Enum.GetValues<EventCategory>())
            {
                <span style="--c: @CalendarFeed.Colors[c]">@(c == EventCategory.Class ? "Class (from program schedules)" : c.DisplayName())</span>
            }
            <span style="--c: @CalendarFeed.BirthdayColor">Birthday</span>
        </div>
        <div class="spinner-border spinner-border-sm text-secondary d-none" id="calLoading" role="status"><span class="visually-hidden">Loading…</span></div>
    </div>
    <div class="card-body">
        <div id="calAlert" class="alert alert-danger d-none"></div>
        <div id="calendar"></div>
        @if (canManage) { <p class="small text-body-secondary mt-3 mb-0">Click a day or drag across times to add an event. Drag events to move them, or drag their edge to change the length. Class times come from each program's schedule and are edited there.</p> }
    </div>
</div>

<div id="calAntiforgery">@Html.AntiForgeryToken()</div>

@if (canManage)
{
    <div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" id="eventForm" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="eventModalTitle">Add event</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none" id="eventError"></div>
                    <input type="hidden" id="evId" />
                    <div class="mb-3">
                        <label class="form-label" for="evTitle">Title <span class="text-danger">*</span></label>
                        <input class="form-control" id="evTitle" maxlength="200" required />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="evAllDay" />
                        <label class="form-check-label" for="evAllDay">All day</label>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-7"><label class="form-label" for="evStartDate">Starts</label><input class="form-control" type="date" id="evStartDate" required /></div>
                        <div class="col-5 timed"><label class="form-label" for="evStartTime">&nbsp;<span class="visually-hidden">Start time</span></label><input class="form-control" type="time" id="evStartTime" step="300" /></div>
                        <div class="col-7"><label class="form-label" for="evEndDate">Ends</label><input class="form-control" type="date" id="evEndDate" /></div>
                        <div class="col-5 timed"><label class="form-label" for="evEndTime">&nbsp;<span class="visually-hidden">End time</span></label><input class="form-control" type="time" id="evEndTime" step="300" /></div>
                        <div class="col-12 form-text">Times are in the branch's local time.</div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="evCategory">Category</label>
                            <select class="form-select" id="evCategory">
                                @foreach (var c in CalendarFeed.Choosable) { <option value="@((int)c)" selected="@(c == EventCategory.Business)">@c.DisplayName()</option> }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="evLocation">Location</label>
                            <input class="form-control" id="evLocation" maxlength="200" placeholder="e.g. Main mat" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="evDescription">Description</label>
                        <textarea class="form-control" id="evDescription" rows="3" maxlength="2000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger me-auto d-none" id="evDelete"><i class="bi bi-trash me-1"></i>Delete</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="evSave"><i class="bi bi-check-lg me-1"></i>Save</button>
                </div>
            </form>
        </div>
    </div>
}

<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-6" id="detailsTitle"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body small" id="detailsBody"></div>
        </div>
    </div>
</div>

<script type="application/json" id="calendarConfig">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(config))</script>
@section Scripts {
    <script src="~/lib/fullcalendar/index.global.min.js"></script>
    <script src="~/js/calendar.js" asp-append-version="true"></script>
}
