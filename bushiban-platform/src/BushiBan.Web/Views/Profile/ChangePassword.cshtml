@model BushiBan.Web.Features.Administration.ProfileController.PasswordInput
@{
    ViewData["Title"] = "Change password";
    ViewData["Breadcrumbs"] = new List<(string, string?)> { ("My profile", Url.Action("Index")), ("Change password", null) };
    string? Err(string key) => ViewContext.ViewData.ModelState.TryGetValue(key, out var e) && e.Errors.Count > 0 ? e.Errors[0].ErrorMessage : null;
    string Invalid(string key) => Err(key) is null ? "" : "is-invalid";
}
<form method="post" class="card form-card" style="max-width: 520px" novalidate>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label" for="CurrentPassword">Current password</label>
            <input class="form-control @Invalid("CurrentPassword")" id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" />
            <div class="invalid-feedback">@Err("CurrentPassword")</div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="NewPassword">New password</label>
            <input class="form-control @Invalid("NewPassword")" id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" />
            <div class="invalid-feedback">@Err("NewPassword")</div>
            <div class="form-text">At least 8 characters with upper and lower case letters and a number.</div>
        </div>
        <div class="mb-1">
            <label class="form-label" for="ConfirmPassword">Confirm new password</label>
            <input class="form-control @Invalid("ConfirmPassword")" id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" />
            <div class="invalid-feedback">@Err("ConfirmPassword")</div>
        </div>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        <button class="btn btn-primary"><i class="bi bi-key me-1"></i>Change password</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
