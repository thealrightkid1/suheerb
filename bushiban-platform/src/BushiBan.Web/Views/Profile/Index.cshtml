@model BushiBan.Web.Features.Administration.ProfileController.ProfileModel
@{
    ViewData["Title"] = "My profile";
    var u = Model.User;
}
@section Head { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
@section Actions {
    <a class="btn btn-outline-secondary" asp-action="Edit"><i class="bi bi-pencil me-1"></i>Edit details</a>
    <a class="btn btn-outline-secondary" asp-action="ChangePassword"><i class="bi bi-key me-1"></i>Change password</a>
}
<div class="row g-3">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="profile-avatar">@(u.Name.Length > 0 ? u.Name[..1].ToUpperInvariant() : "?")</div>
                    <div>
                        <div class="h5 mb-0">@u.Name</div>
                        <div class="text-body-secondary">@u.Email</div>
                    </div>
                </div>
                <dl class="row mb-0 small">
                    <dt class="col-5">Role</dt>
                    <dd class="col-7">@(Model.IsSystemAdmin ? "System admin" : Model.PresetLabel)</dd>
                    <dt class="col-5">Home branch</dt>
                    <dd class="col-7">@(Model.HomeBranch ?? "None")</dd>
                    <dt class="col-5">Other branches</dt>
                    <dd class="col-7">@(Model.IsSystemAdmin ? "All branches" : Model.OtherBranches.Count == 0 ? "None" : string.Join(", ", Model.OtherBranches))</dd>
                    <dt class="col-5">Last sign-in</dt>
                    <dd class="col-7">@(u.LastLoginAt is { } t ? Format.DateTime(Model.Clock.ToLocal(t)) : "—")</dd>
                    <dt class="col-5">Account created</dt>
                    <dd class="col-7 mb-0">@Format.Date(Model.Clock.ToLocal(u.CreatedAt))</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-transparent d-flex justify-content-between">
                <span class="fw-semibold">What I can do</span>
                <span class="small text-body-secondary">@(Model.IsSystemAdmin ? "Everything, in every branch" : $"{Model.PermissionCount} permission(s)")</span>
            </div>
            <div class="card-body">
                @if (Model.Permissions.Count == 0)
                {
                    <p class="text-body-secondary mb-0">You don't have any permissions yet. Ask your manager to set them up.</p>
                }
                @foreach (var g in Model.Permissions)
                {
                    <div class="mb-3">
                        <div class="card-title-sm mb-2">@g.Group</div>
                        <div class="perm-chips">
                            @foreach (var f in g.Features) { <span class="badge text-bg-light border" title="@f.Description">@f.Name</span> }
                        </div>
                    </div>
                }
                <p class="small text-body-secondary mb-0">Need something else? Ask a manager or system admin to change your permissions.</p>
            </div>
        </div>
    </div>
</div>
