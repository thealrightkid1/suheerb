@using BushiBan.Web.Features.Accounting
@model ReportPage<TrialBalanceReport>
@{
    ViewData["Title"] = "Trial balance";
    var r = Model.Report!;
    var f = Model.Filter;
    var period = $"{Format.Date(r.From)} to {Format.Date(r.To)}";
}
@section Head { <link rel="stylesheet" href="@Url.Content(FinanceUi.Stylesheet)" asp-append-version="true" /> }
@section Scripts { <script src="@Url.Content(FinanceUi.Script)" asp-append-version="true"></script> }
@section Actions { <partial name="_ReportActions" /> }
<partial name="_PrintHeader" model='("Trial balance", Model.Scope, period)' />

<div class="card">
    <div class="card-header bg-transparent">
        <form method="get" class="row g-2 align-items-end filter-bar">
            <partial name="_PeriodFilter" model="(f, Model.CanConsolidate, false)" />
            <div class="col-auto pb-2">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="ShowZero" name="ShowZero" value="true" @(f.ShowZero ? "checked" : "") />
                    <label class="form-check-label" for="ShowZero">Show accounts with no activity</label>
                </div>
            </div>
            <div class="col-auto"><button class="btn btn-outline-secondary"><i class="bi bi-arrow-repeat me-1"></i>Update</button></div>
        </form>
        <div class="small muted mt-2 no-print" data-scope="@Model.Scope">@Model.Scope · posted vouchers dated @period</div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 report-table">
            <thead><tr><th>Code</th><th>Account</th><th>Main category</th><th class="money">Debit</th><th class="money">Credit</th><th class="money">Balance</th></tr></thead>
            <tbody>
            @if (r.Rows.Count == 0) { <tr><td colspan="6" class="empty">No posted vouchers in this period.</td></tr> }
            @foreach (var row in r.Rows)
            {
                <tr>
                    <td class="nowrap">@row.Account.Code</td>
                    <td><a asp-action="Ledger" asp-route-code="@row.Account.Code" asp-route-from="@FinanceUi.Iso(r.From)" asp-route-to="@FinanceUi.Iso(r.To)" asp-route-consolidated="@(f.Consolidated ? "true" : null)">@row.Account.Name</a></td>
                    <td>@row.Account.MainName <span class="muted small">(@row.Account.Type)</span></td>
                    <td class="money">@FinanceUi.Money(row.Debit, blankZero: true)</td>
                    <td class="money">@FinanceUi.Money(row.Credit, blankZero: true)</td>
                    <td class="money">@FinanceUi.Money(row.Balance)</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="total"><td colspan="3" class="text-end">Total</td><td class="money">@Format.Money(r.TotalDebit)</td><td class="money">@Format.Money(r.TotalCredit)</td><td></td></tr>
            </tfoot>
        </table>
    </div>
    <div class="card-footer bg-transparent small">
        @if (r.Balanced)
        {
            <span class="check-ok"><i class="bi bi-check-circle-fill me-1"></i>Debits equal credits.</span>
        }
        else
        {
            <span class="check-bad"><i class="bi bi-exclamation-triangle-fill me-1"></i>Debits and credits differ by @Format.Money(Math.Abs(r.TotalDebit - r.TotalCredit)). Please tell your administrator.</span>
        }
        <span class="muted ms-2">Balance is shown the way each account normally grows: debit for assets and expenses, credit for the rest. Drafts aren't included.</span>
    </div>
</div>
