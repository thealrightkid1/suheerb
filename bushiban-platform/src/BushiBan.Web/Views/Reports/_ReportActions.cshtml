@* Print and CSV buttons for a report. The CSV link repeats the current filters. *@
@{
    var query = Context.Request.Query.Where(kv => kv.Key != "format")
        .Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value.ToString())}").Append("format=csv");
    var csvUrl = Context.Request.Path + "?" + string.Join("&", query);
}
<a class="btn btn-outline-secondary" href="@csvUrl"><i class="bi bi-filetype-csv me-1"></i>Export CSV</a>
<button class="btn btn-outline-secondary" data-print><i class="bi bi-printer me-1"></i>Print</button>
