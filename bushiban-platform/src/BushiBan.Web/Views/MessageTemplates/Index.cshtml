@model PagedList<BushiBan.Web.Domain.Communication.MessageTemplate>
@{
    ViewData["Title"] = "Message templates";
    var q = ViewData["q"] as string;
    var channel = ViewData["channel"] as MessageChannel?;
}
@section Head { <link rel="stylesheet" href="~/css/comms.css" asp-append-version="true" /> }
@section Actions {
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add template</a>
}
<p class="text-body-secondary">Ready-made wording for emails and texts. Pick one when writing a message; placeholders like <code>{{FirstName}}</code> are filled in for each person.</p>
<div class="card">
    <div class="card-header bg-transparent">
        <form method="get" class="row g-2" data-autosubmit>
            <div class="col-sm-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input class="form-control" name="q" value="@q" placeholder="Search templates…" />
                </div>
            </div>
            <div class="col-sm-4 col-lg-3">
                <select class="form-select" name="channel" aria-label="Channel">
                    <option value="">Email and text</option>
                    <option value="@MessageChannel.Email" selected="@(channel == MessageChannel.Email)">Email only</option>
                    <option value="@MessageChannel.SMS" selected="@(channel == MessageChannel.SMS)">Text only</option>
                </select>
            </div>
            @if (!string.IsNullOrEmpty(q) || channel is not null) { <div class="col-auto"><a class="btn btn-link" asp-action="Index">Clear</a></div> }
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Name</th><th>Channel</th><th>Subject / message</th><th>Active</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @if (Model.Items.Count == 0) { <tr><td colspan="5" class="empty">No templates found.</td></tr> }
            @foreach (var t in Model.Items)
            {
                <tr>
                    <td><a asp-action="Edit" asp-route-id="@t.Id" class="fw-medium">@t.Name</a></td>
                    <td class="text-nowrap">@if (t.Channel == MessageChannel.Email) { <span><i class="bi bi-envelope me-1"></i>Email</span> } else { <span><i class="bi bi-phone me-1"></i>Text</span> }</td>
                    <td style="max-width: 420px">
                        @if (t.Subject is not null) { <div class="fw-medium text-truncate">@t.Subject</div> }
                        <div class="small text-body-secondary text-truncate">@t.Body</div>
                    </td>
                    <td>@(t.IsActive ? "✓" : "")</td>
                    <td class="text-end text-nowrap">
                        @if (User.HasPermission(Permissions.Communications.Send) && t.IsActive)
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Messages" asp-action="Compose" asp-route-templateId="@t.Id" title="Write a message with this template"><i class="bi bi-send"></i></a>
                        }
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@t.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                        <partial name="_DeleteButton" model='("MessageTemplates", t.Id, "the template \"" + t.Name + "\"")' />
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="(Model.Page, Model.Pages, Model.Total)" />
