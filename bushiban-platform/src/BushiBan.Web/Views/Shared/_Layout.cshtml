@{
    var title = ViewData["Title"] as string ?? "Bushi Ban";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var userName = User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "";
    var crumbs = ViewData["Breadcrumbs"] as IEnumerable<(string Label, string? Url)>;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title · Bushi Ban</title>
    <script>document.documentElement.dataset.bsTheme = localStorage.getItem('bb-theme') || 'light';</script>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/tom-select/tom-select.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/img/logo.svg" type="image/svg+xml" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<div class="app">
    <aside class="sidebar" id="sidebar">
        <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
            <img src="~/img/logo.svg" alt="" width="34" height="34" />
            <span>Bushi Ban</span>
        </a>
        <nav class="sidebar-nav">
            @foreach (var sec in Navigation.For(User))
            {
                @if (sec.Title is not null) { <div class="nav-section">@sec.Title</div> }
                @foreach (var item in sec.Items)
                {
                    var active = string.Equals(controller, item.Controller, StringComparison.OrdinalIgnoreCase)
                                 && (string.Equals(action, item.Action, StringComparison.OrdinalIgnoreCase)
                                     || (item.Action == "Index" && !sec.Items.Any(o => o != item && o.Controller == item.Controller && string.Equals(o.Action, action, StringComparison.OrdinalIgnoreCase))));
                    <a class="nav-link @(active ? "active" : "")" asp-controller="@item.Controller" asp-action="@item.Action">
                        <i class="bi bi-@item.Icon"></i><span>@item.Label</span>
                        @if (item.Badge is not null)
                        {
                            <span class="badge rounded-pill text-bg-danger ms-auto nav-badge">@await Component.InvokeAsync("NavBadges", new { badge = item.Badge })</span>
                        }
                    </a>
                }
            }
        </nav>
    </aside>
    <div class="sidebar-scrim" data-toggle-sidebar></div>

    <div class="main">
        <header class="topbar">
            <button class="btn btn-icon d-lg-none" data-toggle-sidebar aria-label="Menu"><i class="bi bi-list"></i></button>
            @await Component.InvokeAsync("BranchSwitcher")
            <form class="topbar-search" method="get" asp-controller="Search" asp-action="Index" role="search">
                <i class="bi bi-search"></i>
                <input name="q" type="search" placeholder="Search students, leads, phone, email…" value="@Context.Request.Query["q"]" autocomplete="off" />
            </form>
            <div class="ms-auto d-flex align-items-center gap-1">
                <button class="btn btn-icon" id="themeToggle" title="Light / dark"><i class="bi bi-moon-stars"></i></button>
                <div class="dropdown">
                    <button class="btn btn-icon user-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">@(userName.Length > 0 ? userName[..1].ToUpperInvariant() : "?")</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li class="dropdown-header">@userName</li>
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>My profile</a></li>
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change password</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" asp-controller="Account" asp-action="Logout">
                                <button class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="content">
            <div class="page-head">
                <div>
                    @if (crumbs is not null)
                    {
                        <nav aria-label="breadcrumb"><ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Home</a></li>
                            @foreach (var c in crumbs)
                            {
                                if (c.Url is null) { <li class="breadcrumb-item active">@c.Label</li> }
                                else { <li class="breadcrumb-item"><a href="@c.Url">@c.Label</a></li> }
                            }
                        </ol></nav>
                    }
                    <h1>@title</h1>
                </div>
                <div class="page-actions">@await RenderSectionAsync("Actions", required: false)</div>
            </div>
            <partial name="_Flash" />
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/tom-select/tom-select.complete.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
