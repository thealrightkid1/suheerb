@model BushiBan.Web.Infrastructure.BranchSwitcherViewComponent.Model
@if (Model.Options.Count <= 1)
{
    <span class="branch-pill"><i class="bi bi-shop"></i> @Model.CurrentName</span>
}
else
{
    <div class="dropdown">
        <button class="btn btn-sm branch-pill dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Switch branch">
            <i class="bi bi-shop"></i> @Model.CurrentName
        </button>
        <ul class="dropdown-menu shadow-sm branch-menu">
            <li class="dropdown-header">Switch branch</li>
            @foreach (var o in Model.Options)
            {
                <li>
                    <form method="post" asp-controller="Account" asp-action="SwitchBranch">
                        <input type="hidden" name="branchId" value="@o.Id" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button class="dropdown-item @(o.Id == Model.CurrentId ? "active" : "")">@o.Name</button>
                    </form>
                </li>
            }
        </ul>
    </div>
}
