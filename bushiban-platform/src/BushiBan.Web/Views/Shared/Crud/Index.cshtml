@model BushiBan.Web.Infrastructure.Crud.CrudPageModel
@{ ViewData["Title"] = Model.Title; }
@section Actions {
    @if (Model.CanCreate)
    {
        <a class="btn btn-primary" asp-controller="@Model.Controller" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add @Model.Singular.ToLowerInvariant()</a>
    }
}
@if (Model.Intro is not null) { <p class="text-body-secondary">@Model.Intro</p> }
<div class="card">
    <div class="card-header bg-transparent">
        <form method="get" class="row g-2">
            <div class="col-sm-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input class="form-control" name="q" value="@Model.Search" placeholder="Search @Model.Title.ToLowerInvariant()…" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Search)) { <div class="col-auto"><a class="btn btn-link" asp-action="Index">Clear</a></div> }
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr>
                @foreach (var h in Model.Headers) { <th>@h</th> }
                @if (Model.CanEdit || Model.CanDelete) { <th class="text-end">Actions</th> }
            </tr></thead>
            <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="@(Model.Headers.Count + 1)" class="empty">No @Model.Title.ToLowerInvariant() found.</td></tr>
            }
            @foreach (var row in Model.Rows)
            {
                <tr>
                    @for (var i = 0; i < row.Cells.Count; i++)
                    {
                        if (i == 0 && Model.CanEdit) { <td><a asp-controller="@Model.Controller" asp-action="Edit" asp-route-id="@row.Id" class="fw-medium">@row.Cells[i]</a></td> }
                        else { <td>@row.Cells[i]</td> }
                    }
                    @if (Model.CanEdit || Model.CanDelete)
                    {
                        <td class="text-end text-nowrap">
                            @if (Model.CanEdit) { <a class="btn btn-sm btn-outline-secondary" asp-controller="@Model.Controller" asp-action="Edit" asp-route-id="@row.Id" title="Edit"><i class="bi bi-pencil"></i></a> }
                            @if (Model.CanDelete) { <partial name="_DeleteButton" model='(Model.Controller, row.Id, "this " + Model.Singular.ToLowerInvariant())' /> }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
@if (Model.Paging is not null) { <partial name="_Pager" model="(Model.Paging.Page, Model.Paging.Pages, Model.Paging.Total)" /> }
